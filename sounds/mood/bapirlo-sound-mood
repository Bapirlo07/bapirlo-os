#!/usr/bin/env python3
"""Bapirlo OS — login + unlock sounds in the wallpaper's mood (generated, no samples).
  bapirlo-sound-mood            write them for the active Theme Studio palette
  bapirlo-sound-mood --play     … and play the login one
  bapirlo-sound-mood off        put the original Kenney login sound back (unlock: none)
The accent's hue picks the key (red = A, round the colour wheel a semitone per 30°), warm accents
play major, cool ones minor; a vivid accent adds more shimmer. Login = a rising four-note bell with a
blade "shing"; unlock = two soft notes. Theme Studio runs this after every theme change.
"""
import colorsys
import json
import os
import shutil
import subprocess
import sys
import tempfile
import wave

import numpy as np

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "bapirlo")
OUT = os.path.join(os.environ.get("XDG_DATA_HOME", HOME + "/.local/share"), "sounds", "bapirlo", "stereo")
ORIG = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "theme", "bapirlo", "stereo")
RATE = 48000
KURO_CRIMSON = "#E11D2E"


def accent():
    try:
        with open(os.path.join(STATE, "studio", "active.json")) as f:
            return json.load(f)["palette"]["crimson"]
    except (OSError, ValueError, KeyError):
        return KURO_CRIMSON


def mood(hexc):
    r, g, b = (int(hexc[i:i + 2], 16) / 255 for i in (1, 3, 5))
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    hue = h * 360
    root = 220.0 * 2 ** (round(hue / 30) % 12 / 12)        # A3 … G#4
    warm = hue < 75 or hue > 290
    third = 4 if warm else 3
    return root, third, min(1.0, s * 1.2)


def bell(freq, dur, vivid, decay=2.6):
    t = np.arange(int(RATE * dur)) / RATE
    partials = [(1, 1.0), (2.0, 0.35), (3.01, 0.18 * vivid), (4.2, 0.10 * vivid), (5.43, 0.05 * vivid)]
    x = sum(a * np.sin(2 * np.pi * freq * m * t) * np.exp(-t * decay * (1 + 0.6 * i))
            for i, (m, a) in enumerate(partials))
    attack = np.minimum(1, t / 0.006)
    return x * attack


def place(buf, sig, at, pan):
    i = int(at * RATE)
    n = min(len(sig), len(buf) - i)
    buf[i:i + n, 0] += sig[:n] * (1 - pan) ** 0.5
    buf[i:i + n, 1] += sig[:n] * (1 + pan) ** 0.5


def shing(dur, vivid, rng):
    n = int(RATE * dur)
    t = np.arange(n) / RATE
    noise = rng.standard_normal(n)
    hp = np.diff(noise, prepend=0)                        # crude high-pass: a bright metallic hiss
    hp = np.diff(hp, prepend=0)
    return hp * np.exp(-t * 28) * 0.05 * (0.5 + vivid)


def login(root, third, vivid):
    total = 1.9
    buf = np.zeros((int(RATE * total), 2))
    rng = np.random.default_rng(7)
    sh = shing(0.35, vivid, rng)
    place(buf, sh, 0.0, -0.3)
    notes = [0, third, 7, 12]
    for i, semi in enumerate(notes):
        f = root * 2 ** (semi / 12)
        place(buf, bell(f, total - 0.09 * i, vivid) * (0.9 - 0.08 * i), 0.05 + 0.09 * i, -0.45 + 0.3 * i)
    # a low pad underneath, swelling in
    t = np.arange(len(buf)) / RATE
    pad = (np.sin(2 * np.pi * root / 2 * t) + 0.3 * np.sin(2 * np.pi * root * 2 ** (7 / 12) / 2 * t))
    pad *= np.minimum(1, t / 0.5) * np.exp(-np.maximum(0, t - 0.5) * 2.2) * 0.22
    buf += pad[:, None]
    return finish(buf, -4)


def unlock(root, third, vivid):
    total = 0.9
    buf = np.zeros((int(RATE * total), 2))
    place(buf, bell(root * 2 ** (7 / 12), total, vivid * 0.6, decay=4.5) * 0.8, 0.0, -0.2)
    place(buf, bell(root * 2, total - 0.11, vivid * 0.6, decay=4.5), 0.11, 0.2)
    return finish(buf, -11)


def finish(buf, db):
    fade = int(RATE * 0.12)
    buf[-fade:] *= np.linspace(1, 0, fade)[:, None]
    peak = np.abs(buf).max() or 1
    return buf / peak * 10 ** (db / 20)


def write_oga(buf, path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    pcm = (np.clip(buf, -1, 1) * 32767).astype("<i2")
    with tempfile.TemporaryDirectory() as tmp:
        wav = os.path.join(tmp, "s.wav")
        with wave.open(wav, "wb") as w:
            w.setnchannels(2)
            w.setsampwidth(2)
            w.setframerate(RATE)
            w.writeframes(pcm.tobytes())
        new = path + ".new.oga"
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", wav, "-c:a", "libvorbis", "-q:a", "5", new], check=True)
        os.replace(new, path)


def main(argv):
    if argv[:1] == ["off"]:
        shutil.copy2(os.path.join(ORIG, "desktop-login.oga"), os.path.join(OUT, "desktop-login.oga"))
        unl = os.path.join(OUT, "desktop-screen-unlock.oga")
        if os.path.exists(unl):
            os.remove(unl)
        print("sounds: original login sound back, no unlock sound")
        return 0
    hexc = accent()
    root, third, vivid = mood(hexc)
    write_oga(login(root, third, vivid), os.path.join(OUT, "desktop-login.oga"))
    write_oga(unlock(root, third, vivid), os.path.join(OUT, "desktop-screen-unlock.oga"))
    print(f"sounds: {hexc} → root {root:.0f} Hz, {'major' if third == 4 else 'minor'}, shimmer {vivid:.2f}")
    if "--play" in argv:
        subprocess.run(["pw-play", os.path.join(OUT, "desktop-login.oga")])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
