#!/usr/bin/env python3
"""Bapirlo OS — screenshots with annotation + colour picker (GNOME screenshot portal).

  bapirlo-capture shot   (Print)        GNOME's own selection UI (area / window / screen, works on
                                        both monitors and with fractional scaling) → the picture is
                                        saved to ~/Pictures/Screenshots and opened in Satty to
                                        annotate. In Satty: Ctrl+S saves over it, Ctrl+C copies,
                                        Esc closes (the plain screenshot is already saved).
  bapirlo-capture pick   (Super+Shift+C) GNOME's colour picker → hex copied to the clipboard,
                                        notification with a swatch, history in
                                        ~/.local/state/bapirlo/colours.txt

Why the portal and not grim/Flameshot: GNOME doesn't let other programs grab the screen
directly on Wayland, so they either fail or ask permission every time. The portal is GNOME's
supported way and costs nothing while not in use.
"""
import datetime
import os
import shutil
import subprocess
import sys
import urllib.parse

from gi.repository import Gio, GLib

BUS = Gio.bus_get_sync(Gio.BusType.SESSION)
PORTAL, PATH, IFACE = "org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop", "org.freedesktop.portal.Screenshot"
SHOTS = os.path.join(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) or
                     os.path.expanduser("~/Pictures"), "Screenshots")
STATE = os.path.join(GLib.get_user_state_dir(), "bapirlo")


def portal(method, options):
    """Call a Screenshot portal method and wait for its Response signal → (code, results)."""
    token = f"bapirlo{os.getpid()}"
    sender = BUS.get_unique_name()[1:].replace(".", "_")
    request = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
    loop = GLib.MainLoop()
    out = {}

    def on_response(_c, _s, _p, _i, _sig, params):
        out["code"], out["results"] = params.unpack()
        loop.quit()

    sub = BUS.signal_subscribe(PORTAL, "org.freedesktop.portal.Request", "Response", request,
                               None, Gio.DBusSignalFlags.NONE, on_response)
    opts = {"handle_token": GLib.Variant("s", token)}
    opts.update(options)
    BUS.call_sync(PORTAL, PATH, IFACE, method, GLib.Variant("(sa{sv})", ("", opts)),
                  None, Gio.DBusCallFlags.NONE, -1, None)
    GLib.timeout_add_seconds(300, loop.quit)        # never hang forever
    loop.run()
    BUS.signal_unsubscribe(sub)
    return out.get("code", 2), out.get("results", {})


def notify(title, body, icon):
    subprocess.Popen(["notify-send", "-a", "Bapirlo OS", "-i", icon, title, body])


def shot():
    code, res = portal("Screenshot", {"interactive": GLib.Variant("b", True),
                                      "modal": GLib.Variant("b", True)})
    if code != 0 or "uri" not in res:
        return 1                                    # cancelled
    src = urllib.parse.unquote(urllib.parse.urlparse(res["uri"]).path)
    os.makedirs(SHOTS, exist_ok=True)
    dst = os.path.join(SHOTS, datetime.datetime.now().strftime("Screenshot_%Y-%m-%d_%H-%M-%S.png"))
    try:
        shutil.move(src, dst)
    except OSError:
        shutil.copy(src, dst)
    if shutil.which("wl-copy"):
        with open(dst, "rb") as f:
            subprocess.Popen(["wl-copy", "--type", "image/png"], stdin=f)
    if shutil.which("satty"):
        os.execvp("satty", ["satty", "--filename", dst, "--output-filename", dst])
    notify("Screenshot saved", dst, "applets-screenshooter-symbolic")
    return 0


def pick():
    code, res = portal("PickColor", {})
    if code != 0 or "color" not in res:
        return 1
    r, g, b = (max(0, min(255, round(c * 255))) for c in res["color"])
    hexv = f"#{r:02X}{g:02X}{b:02X}"
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy", hexv])
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "colours.txt"), "a") as f:
        f.write(f"{datetime.datetime.now():%Y-%m-%d %H:%M}  {hexv}  rgb({r}, {g}, {b})\n")
    # swatch for the notification
    swatch = os.path.join(GLib.get_user_runtime_dir(), "bapirlo-swatch.png")
    try:
        from gi.repository import GdkPixbuf
        pb = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, 64, 64)
        pb.fill((r << 24) | (g << 16) | (b << 8) | 0xFF)
        pb.savev(swatch, "png", [], [])
    except (ImportError, GLib.Error):
        swatch = "color-select-symbolic"
    notify(f"{hexv} copied", f"rgb({r}, {g}, {b})", swatch)
    return 0


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "shot":
        sys.exit(shot())
    if cmd == "pick":
        sys.exit(pick())
    print(__doc__.split("\n\n")[1])
    sys.exit(2)
