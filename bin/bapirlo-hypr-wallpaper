#!/usr/bin/env python3
"""Bapirlo OS — wallpaper for the Hyprland session (GNOME uses Hanabi instead).

Follows the same ~/.config/bapirlo/wallpaper.json as the Wallpapers app: a video with live on →
mpvpaper plays it (iGPU VA-API, muted, looping, paused while windows cover it); otherwise →
the still frame. Re-reads on every change, so the app, `bapirlo-wallpaper next` and the
Waybar button all just work.

  bapirlo-hypr-wallpaper            run (exec-once in hyprland.conf)
  bapirlo-hypr-wallpaper --waybar   one JSON line for Waybar's live button
"""
import json
import os
import signal
import subprocess
import sys

from gi.repository import Gio, GLib

HOME = os.path.expanduser("~")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "bapirlo", "wallpaper.json")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state")),
                     "bapirlo", "wallpaper", "current.json")
VIDEO = (".mp4", ".webm", ".mkv", ".mov", ".gif")
HYPR_THEME = os.path.join(HOME, "bapirlo-os", "tools", "hypr-theme.py")


def read(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def wanted():
    """(file, is_video) to show now."""
    conf, state = read(CONF), read(STATE)
    cur = conf.get("current") or state.get("path") or ""
    if cur.lower().endswith(VIDEO):
        if conf.get("live", True) and os.path.exists(cur):
            return cur, True
        return state.get("still") or "", False
    return cur, False


def waybar():
    conf = read(CONF)
    cur = conf.get("current") or ""
    if not cur.lower().endswith(VIDEO):
        print(json.dumps({"text": "", "class": "hidden", "tooltip": "Picture wallpaper"}))
        return
    on = conf.get("live", True)
    print(json.dumps({"text": "" if on else "", "class": "on" if on else "off",
                      "tooltip": f"Live wallpaper {'on' if on else 'off'} — click to switch, right-click for Wallpapers"}))


class Daemon:
    def __init__(self):
        self.proc = None
        self.shown = None
        self.loop = GLib.MainLoop()
        self.timer = 0
        self.monitors = []
        for path in (CONF, STATE):
            os.makedirs(os.path.dirname(path), exist_ok=True)
            m = Gio.File.new_for_path(path).monitor_file(Gio.FileMonitorFlags.WATCH_MOVES, None)
            m.connect("changed", lambda *_: self.queue())
            self.monitors.append(m)

    def queue(self):
        # the app writes both files in quick succession; settle first
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(400, self.sync)

    def sync(self):
        self.timer = 0
        want = wanted()
        if want == self.shown and self.proc and self.proc.poll() is None:
            return GLib.SOURCE_REMOVE
        self.stop()
        self.shown = want
        path, video = want
        if path and os.path.exists(path):
            opts = "no-audio panscan=1.0 hwdec=vaapi"
            if video:
                opts += " loop-file=inf"
            else:
                opts += " image-display-duration=inf"
            # -p: pause while the wallpaper is fully hidden behind windows
            self.proc = subprocess.Popen(["mpvpaper", "-p", "-o", opts, "*", path],
                                         env={**os.environ, "LIBVA_DRIVER_NAME": "iHD"},
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["pkill", "-RTMIN+8", "-x", "waybar"], capture_output=True)
        subprocess.Popen([HYPR_THEME], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)  # lock screen still
        return GLib.SOURCE_REMOVE

    def stop(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(3)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.proc = None

    def run(self):
        for s in (signal.SIGTERM, signal.SIGINT):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, s, self.quit)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGHUP, lambda: (self.queue(), True)[1])
        self.sync()
        GLib.timeout_add_seconds(5, self.watchdog)
        self.loop.run()

    def watchdog(self):
        if self.shown and self.shown[0] and (not self.proc or self.proc.poll() is not None):
            self.queue()   # mpvpaper died (e.g. monitor hot-plug) → restart it
        return GLib.SOURCE_CONTINUE

    def quit(self):
        self.stop()
        self.loop.quit()
        return GLib.SOURCE_REMOVE


if __name__ == "__main__":
    if "--waybar" in sys.argv:
        waybar()
    else:
        Daemon().run()
