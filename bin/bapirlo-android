#!/usr/bin/env bash
# Kuro OS — Android (Waydroid) in one command.
#   bapirlo-android               open Android full screen (starts it if needed)
#   bapirlo-android stop          shut Android down (frees RAM)
#   bapirlo-android status        is it running, does it have internet
#   bapirlo-android install X.apk install an app from an .apk file
#   bapirlo-android apps          list installed Android apps
# Android apps also show up in the normal app menu once installed.
# No internet? → sudo bash ~/bapirlo-os/910-waydroid-net.sh (opens the firewall for waydroid0)
set -euo pipefail

ip_of() { waydroid status 2>/dev/null | awk -F'\t' '/IP address/ {print $2}'; }

ensure_session() {
  systemctl is-active -q waydroid-container || {
    notify-send -a Android -i waydroid "Android" "Starting Waydroid…" || true
    pkexec systemctl start waydroid-container
  }
  if ! waydroid status 2>/dev/null | grep -q 'Session:.*RUNNING'; then
    waydroid session start >/dev/null 2>&1 &
    for _ in $(seq 30); do
      waydroid status 2>/dev/null | grep -q 'Session:.*RUNNING' && break
      sleep 1
    done
  fi
}

case "${1:-}" in
  stop)
    waydroid session stop || true ;;
  status)
    waydroid status
    ipaddr=$(ip_of)
    if [ -z "$ipaddr" ] || [ "$ipaddr" = UNKNOWN ]; then
      echo "Internet: NO (Android has no address) — run: sudo bash ~/bapirlo-os/910-waydroid-net.sh"
      exit 1
    fi
    echo "Internet: Android has address $ipaddr" ;;
  install)
    [ -f "${2:-}" ] || { echo "usage: bapirlo-android install file.apk"; exit 1; }
    ensure_session
    waydroid app install "$2" && echo "Installed — it's in the app menu now." ;;
  apps)
    ensure_session
    waydroid app list | awk -F': ' '/^Name/ {print $2}' ;;
  "")
    ensure_session
    exec waydroid show-full-ui ;;
  *)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
