# Bapirlo OS — Timeshift snapshot before packages are upgraded (/usr/local/lib/bapirlo/bapirlo-presnap)
# Off: sudo rm /etc/pacman.d/hooks/00-bapirlo-timeshift.hook
[Trigger]
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Bapirlo: Timeshift snapshot before update...
When = PreTransaction
Exec = /usr/local/lib/bapirlo/bapirlo-presnap
NeedsTargets
