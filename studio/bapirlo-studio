#!/usr/bin/env python3
"""Kuro OS Theme Studio — command line (the app, the Control Centre tile and the watchers use it).

  bapirlo-studio extract IMAGE [--accent HEX] [--vivid N] [--tint N]   palette + contrast report (JSON)
  bapirlo-studio save NAME IMAGE [--accent HEX] [--vivid N] [--tint N] store as a preset → prints its id
  bapirlo-studio apply ID | original                                     re-theme everything (no password)
  bapirlo-studio list | status
  bapirlo-studio delete ID
  bapirlo-studio refresh           rebuild the active preset if a source theme changed (run at login)
  bapirlo-studio notify-new        a picture landed in ~/Pictures/Theme Studio → "Preview" notification
  bapirlo-studio boot-plan [ID]    what "Also apply to login & boot" would change (no changes)
  bapirlo-studio boot ID | original  stage the splash and run the root helper (pkexec → password)
"""
import argparse
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import engine as E   # noqa: E402
import studio as S   # noqa: E402


def palette_args(a):
    return dict(accent=a.accent, vivid=a.vivid, tint=a.tint)


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("cmd", nargs="?", default="status")
    ap.add_argument("args", nargs="*")
    ap.add_argument("--accent")
    ap.add_argument("--vivid", type=float, default=1.0)
    ap.add_argument("--tint", type=float, default=1.0)
    ap.add_argument("--no-fade", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help:
        print(__doc__)
        return 0

    if a.cmd == "extract":
        p = E.palette_from_image(a.args[0], **palette_args(a))
        print(json.dumps(p, indent=1))
    elif a.cmd == "save":
        name, img = a.args[0], a.args[1]
        p = S.save_preset(name, img, E.palette_from_image(img, **palette_args(a)))
        print(p["id"])
    elif a.cmd == "apply":
        pid = a.args[0] if a.args else "original"
        S.apply_preset(pid, fade=not a.no_fade)
    elif a.cmd == "list":
        act = (S.active() or {}).get("preset", "original")
        for p in S.presets():
            print(("* " if p["id"] == act else "  ") + f'{p["id"]:44} {p["name"]}')
    elif a.cmd == "status":
        act = S.active()
        print(f'Theme Studio: {act["name"]} (slot {act["slot"]})' if act else "Theme Studio: Original Kuro OS")
    elif a.cmd == "delete":
        S.delete_preset(a.args[0])
    elif a.cmd == "refresh":
        S.refresh_if_stale()
    elif a.cmd == "notify-new":
        notify_new()
    elif a.cmd == "boot":
        ok, out = S.apply_boot(a.args[0] if a.args else (S.active() or {}).get("preset", "original"))
        print(out)
        return 0 if ok else 1
    elif a.cmd == "boot-plan":
        print(boot_plan(a.args[0] if a.args else None))
    else:
        print(__doc__)
        return 64
    return 0


def notify_new():
    """Called by bapirlo-studio-watch.path: offer a preview of the newest picture once."""
    seen_path = os.path.join(S.STATE, "seen.json")
    seen = set(S.load_json(seen_path, []))
    new = [w for w in S.wallpapers() if w not in seen and time.time() - os.path.getmtime(w) < 600]
    S.write_atomic(seen_path, json.dumps(sorted(seen | set(S.wallpapers()))))
    if not new or app_open():       # the open window shows new pictures by itself
        return
    img = new[0]
    r = subprocess.run(["notify-send", "-a", "Theme Studio", "-i", "bapirlo-studio", "-A", "preview=Preview theme",
                        "--wait", "New wallpaper in Theme Studio", os.path.basename(img)],
                       capture_output=True, text=True)
    if r.stdout.strip() == "preview":
        app = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bapirlo-theme-studio")
        subprocess.Popen([app, img], start_new_session=True)


def app_open():
    r = subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.DBus", "--object-path",
                        "/org/freedesktop/DBus", "--method", "org.freedesktop.DBus.NameHasOwner", "os.bapirlo.Wallpapers"],
                       capture_output=True, text=True)
    return "true" in r.stdout


def boot_plan(pid=None):
    act = S.active()
    pid = pid or (act or {}).get("preset", "original")
    p = S.get_preset(pid)
    return "\n".join([
        f'Boot splash → "{p["name"]}". Needs your password. What changes:',
        "  • /usr/share/plymouth/themes/bapirlo-kuro — the background and the coloured pieces",
        "    (embers, eyes, halo, logo, progress bar, password box) " + ("put back to the original Kuro colours"
                                                                       if pid == "original" else "recoloured"),
        "  • The boot images are rebuilt (mkinitcpio -P, about a minute) and each one is checked to",
        "    contain the new splash. If anything fails, the old splash and images are put back.",
        "  • Backup first: ~/theme-backups/<time>-studio-boot (splash folder + boot images)",
        "  Not touched: GRUB / Limine, kernels, mkinitcpio.conf, partitions, the EFI partition, Windows.",
        "  The login & lock screen already follow every Apply (no password needed)."])


if __name__ == "__main__":
    sys.exit(main())
