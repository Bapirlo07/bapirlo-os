## Kuro OS "Kuro" — cava audio visualiser. Palette: ~/bapirlo-os/tools/palette.py
## Run in a terminal: cava   (q quits, arrow keys = sensitivity / bar width)

[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1
## lower_cutoff/higher_cutoff keep the bars musical, not hissy
lower_cutoff_freq = 50
higher_cutoff_freq = 12000
sleep_timer = 5

[input]
## PipeWire is your audio server; cava follows the default output (what you hear)
method = pipewire
source = auto

[output]
method = noncurses
channels = stereo
mono_option = average
reverse = 0

[color]
background = default
foreground = '#E11D2E'

## blood → crimson → ember → sakura at the peaks
gradient = 1
gradient_count = 5
gradient_color_1 = '#7A0F1A'
gradient_color_2 = '#B8141F'
gradient_color_3 = '#E11D2E'
gradient_color_4 = '#FF4655'
gradient_color_5 = '#F08AA4'

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 77
