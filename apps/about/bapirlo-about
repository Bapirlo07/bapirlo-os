#!/usr/bin/env python3
"""Bapirlo OS — "About This PC" (GTK4 / libadwaita, Kuro styling).

Hardware facts come from one `fastfetch --format json` call (~0.1 s), MSI EC facts from msi-ec
when it is loaded. Buttons open Settings, MSI Control Center and Timeshift.
"""
import json
import os
import shutil
import subprocess
import sys

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "os.bapirlo.About"
HERE = os.path.dirname(os.path.realpath(__file__))
LOGO = os.path.expanduser("~/.local/share/icons/Bapirlo/scalable/apps/bapirlo.svg")
EC = "/sys/devices/platform/msi-ec"

CSS = """
window.bapirlo-about { background-color: #0E0A0D; color: #F2E9EC; }
.hero {
  background-image: linear-gradient(180deg, rgba(225,29,46,0.30), rgba(14,10,13,0.0) 85%),
                    radial-gradient(circle at 50% 0%, rgba(255,70,85,0.35), transparent 60%);
  border-bottom: 1px solid rgba(225,29,46,0.28);
  padding: 18px 24px 22px 24px;
}
.brand { font-family: Bangers; font-size: 34pt; letter-spacing: 3px; color: #FFFFFF;
         text-shadow: 3px 3px 0 #7A0F1A; }
.tagline { color: #CAB5BF; font-weight: 500; }
.chip { font-family: Bangers; font-size: 13pt; letter-spacing: 1px; color: #FFFFFF;
        background-color: #E11D2E; border-radius: 6px; padding: 1px 10px 0 10px;
        box-shadow: 2px 2px 0 rgba(14,10,13,0.9); }
.devname { font-size: 15pt; font-weight: 700; }
preferencesgroup > box > label.heading { color: #FF4655; font-family: Bangers; font-size: 14pt; letter-spacing: 1.5px; }
list.boxed-list { background-color: rgba(22,16,21,0.94); border: 1px solid rgba(225,29,46,0.28);
                  border-radius: 16px; box-shadow: none; }
list.boxed-list > row { border-color: rgba(242,233,236,0.06); }
row .title { color: #CAB5BF; }
row .subtitle { color: #F2E9EC; font-weight: 600; opacity: 1; }
button.kuro { border-radius: 10px; padding: 8px 14px; background-color: rgba(242,233,236,0.07);
              color: #F2E9EC; font-weight: 600; transition: 180ms; }
button.kuro:hover { background-color: rgba(225,29,46,0.22); }
button.kuro.accent { background-color: #E11D2E; color: #FFFFFF; }
button.kuro.accent:hover { background-color: #FF4655; }
"""


def gib(n):
    return f"{n / 1024 ** 3:.1f} GB"


def read(path):
    try:
        return open(path).read().strip()
    except OSError:
        return None


def facts():
    try:
        out = subprocess.run(["fastfetch", "-s", "host:cpu:gpu:memory:disk:display:de:kernel:os:uptime",
                              "--format", "json"], capture_output=True, text=True, timeout=5).stdout
        data = {m["type"]: m.get("result") for m in json.loads(out)}
    except Exception:
        data = {}
    host = data.get("Host") or {}
    cpu = data.get("CPU") or {}
    gpus = data.get("GPU") or []
    mem = data.get("Memory") or {}
    disks = [d for d in (data.get("Disk") or []) if d.get("mountpoint") == "/"]
    displays = data.get("Display") or []
    de = data.get("DE") or {}
    os_ = data.get("OS") or {}
    up = (data.get("Uptime") or {}).get("uptime", 0) // 1000
    pretty = subprocess.run(["hostnamectl", "--pretty"], capture_output=True, text=True).stdout.strip()

    rows = {"device": [], "system": [], "msi": []}
    rows["device"] += [
        ("Model", f"MSI {host.get('name', '?')}"),
        ("Processor", f"{cpu.get('cpu', '?').replace('(R)', '').replace('(TM)', '')} · "
                      f"{(cpu.get('cores') or {}).get('logical', '?')} threads"),
        ("Graphics", "\n".join(sorted({g.get("name", "?") for g in gpus})) or "?"),
        ("Memory", gib(mem.get("total", 0)) if mem else "?"),
        ("Storage", f"{gib(disks[0]['bytes']['total'])} · {gib(disks[0]['bytes']['available'])} free"
                    if disks else "?"),
        ("Display", "\n".join(f"{d['output']['width']}×{d['output']['height']} @ "
                              f"{round(d['output']['refreshRate'])} Hz"
                              f"{'  (built-in)' if d.get('primary') else ''}" for d in displays) or "?"),
    ]
    h, m = divmod(up // 60, 60)
    rows["system"] += [
        ("Operating system", f"Bapirlo OS — Kuro edition\n{os_.get('prettyName', 'CachyOS')} base, rolling"),
        ("Desktop", f"GNOME {de.get('version', '?')} · Wayland"),
        ("Kernel", platform_release()),
        ("Device name", f"{pretty or 'Bapirlo OS'}  ({GLib.get_host_name()})"),
        ("Up for", f"{h // 24}d {h % 24}h {m}m" if h >= 24 else f"{h}h {m}m"),
    ]
    if os.path.isdir(EC):
        limit = read("/sys/class/power_supply/BAT1/charge_control_end_threshold")
        rows["msi"] += [
            ("EC firmware", read(f"{EC}/fw_version") or "?"),
            ("Performance mode", (read(f"{EC}/shift_mode") or "?").capitalize()),
            ("Fan mode", (read(f"{EC}/fan_mode") or "?").capitalize()),
            ("Battery charge limit", f"{limit} %" if limit else "—"),
        ]
    return pretty, rows


def platform_release():
    return os.uname().release


class About(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window
        if win:
            win.present()
            return
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        prov = Gtk.CssProvider()
        prov.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = Adw.ApplicationWindow(application=self, title="About This PC",
                                    default_width=560, default_height=760)
        win.add_css_class("bapirlo-about")
        view = Adw.ToolbarView()
        hb = Adw.HeaderBar(show_title=False)
        hb.add_css_class("flat")
        view.add_top_bar(hb)

        pretty, rows = facts()
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, halign=Gtk.Align.FILL)
        hero.add_css_class("hero")
        if os.path.exists(LOGO):
            hero.append(Gtk.Image(file=LOGO, pixel_size=112))
        brand = Gtk.Label(label="BAPIRLO OS")
        brand.add_css_class("brand")
        hero.append(brand)
        line = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        chip = Gtk.Label(label="KURO")
        chip.add_css_class("chip")
        tag = Gtk.Label(label="edition · built on CachyOS")
        tag.add_css_class("tagline")
        line.append(chip)
        line.append(tag)
        hero.append(line)
        dev = Gtk.Label(label=pretty or "Bapirlo OS", margin_top=8)
        dev.add_css_class("devname")
        hero.append(dev)
        content.append(hero)

        page = Adw.PreferencesPage()
        for key, title in (("device", "Device"), ("system", "System"), ("msi", "MSI")):
            if not rows[key]:
                continue
            group = Adw.PreferencesGroup(title=title)
            for t, v in rows[key]:
                row = Adw.ActionRow(title=t, subtitle=v, subtitle_selectable=True)
                row.add_css_class("property")
                group.add(row)
            page.add(group)

        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER, margin_top=6, margin_bottom=18)
        for label, cmd, accent in (("System Settings", ["gnome-control-center", "system"], True),
                                   ("MSI Control Center", ["mcontrolcenter"], False),
                                   ("Snapshots", ["timeshift-launcher"], False)):
            if not shutil.which(cmd[0]):
                continue
            b = Gtk.Button(label=label)
            b.add_css_class("kuro")
            if accent:
                b.add_css_class("accent")
            b.connect("clicked", lambda _b, c=cmd: subprocess.Popen(c, start_new_session=True))
            buttons.append(b)
        grp = Adw.PreferencesGroup()
        grp.add(buttons)
        page.add(grp)

        content.append(page)
        page.set_vexpand(True)
        view.set_content(content)
        win.set_content(view)
        win.present()


if __name__ == "__main__":
    sys.exit(About().run(sys.argv))
