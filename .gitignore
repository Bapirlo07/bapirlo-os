# --- upstream code & binaries: install.sh fetches them (pinned commits)
/src/
/tools/realesrgan/

# --- anything generated from the wallpaper. The original art is third-party fan art,
#     so it is never committed — install.sh rebuilds all of it from YOUR wallpaper.
/build/**/*.png
/build/**/*.jpg
/build/**/*.jpeg
/build/**/*.gif
/build/**/*.pf2
/build/art/
/apps/chrome-theme/images/

# --- local / machine state
*.log
__pycache__/
*.pyc
*.bak-*
local.conf
location.json

# --- greeter theme images built from the wallpaper (tools/build-greeter.sh)
/greeter/bapirlo/img/bg*.jpg
/greeter/bapirlo/img/avatar*.png

# --- screenshots that show the fan-art wallpaper: local only
/screenshots/local/

# --- secrets & personal data: never commit (tools/pre-commit also scans every commit)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.kdbx
*.keyring
id_rsa*
id_ed25519*
*.nmconnection
rclone.conf
*secret*
*token*
*credentials*
*password*
api-key*
config/local*
# exported settings get checked by the exporter; raw dumps are not allowed
*.dconf.raw
dconf-dump*

# upstream UxPlay clone + build (our changes: patches/uxplay-dbb8a8f-bapirlo.patch)
tools/uxplay/
tools/uxplay-src/
