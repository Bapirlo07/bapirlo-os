open-app-animation=true
pressure-sense=false
running-indicator-color=(1.0, 0.56100000000000005, 0.624, 1.0)
running-indicator-size=0
running-indicator-style=1
separator-color=(0.32200000000000001, 0.23100000000000001, 0.26700000000000002, 1.0)
