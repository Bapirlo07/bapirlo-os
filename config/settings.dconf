[org/gnome/shell/extensions/desktop-cube]
do-explode=true
enable-desktop-dragging=true
enable-desktop-edge-switch=false
enable-overview-dragging=true
enable-overview-edge-switch=false
enable-panel-dragging=false
window-parallax=0.5

[org/gnome/shell/extensions/emoji-copy]
active-keybind=true
always-show=false
emoji-keybind=['<Super>period']
emojisize=28
keep-open=false
nbcols=9
paste-on-select=true
recently-used=['😂', '❤️', '😍', '😭', '😊', '😒', '😘', '😩', '🤔']
window-location='cursor'

[org/gnome/shell/extensions/gtk4-ding]
free-position-icons=true
icon-size='standard'
show-desktop-widgets=false
show-home=true
show-network-volumes=false
show-second-monitor=false
show-trash=true
show-volumes=true
start-corner='top-left'

[org/gnome/shell/extensions/ncom/github/hermes83/compiz-alike-magic-lamp-effect]
duration=300.0
x-tiles=8.0
y-tiles=8.0

[org/gnome/shell/extensions/rounded-window-corners-reborn]
border-width=0
keep-shadow-for-maximized-fullscreen=false
settings-version=uint32 9
skip-libadwaita-app=true

[org/gnome/shell/extensions/simple-weather]
is-activated=true
my-loc-provider='disable'
panel-box='center'
panel-priority=int64 1
show-panel-icon=true
symbolic-icons-panel=true
temp-unit='celsius'
unit-preset='uk'
weather-provider='open-meteo'

[org/gnome/shell/extensions/tilingshell]
enable-blur-selected-tilepreview=false
enable-blur-snap-assistant=false
enable-move-keybindings=true
enable-snap-assist=true
enable-window-border=false
inner-gaps=uint32 10
layouts-json='[{"id":"Layout 1","tiles":[{"x":0,"y":0,"width":0.22,"height":0.5,"groups":[1,2]},{"x":0,"y":0.5,"width":0.22,"height":0.5,"groups":[1,2]},{"x":0.22,"y":0,"width":0.56,"height":1,"groups":[2,3]},{"x":0.78,"y":0,"width":0.22,"height":0.5,"groups":[3,4]},{"x":0.78,"y":0.5,"width":0.22,"height":0.5,"groups":[3,4]}]},{"id":"Layout 2","tiles":[{"x":0,"y":0,"width":0.22,"height":1,"groups":[1]},{"x":0.22,"y":0,"width":0.56,"height":1,"groups":[1,2]},{"x":0.78,"y":0,"width":0.22,"height":1,"groups":[2]}]},{"id":"Layout 3","tiles":[{"x":0,"y":0,"width":0.33,"height":1,"groups":[1]},{"x":0.33,"y":0,"width":0.67,"height":1,"groups":[1]}]},{"id":"Layout 4","tiles":[{"x":0,"y":0,"width":0.67,"height":1,"groups":[1]},{"x":0.67,"y":0,"width":0.33,"height":1,"groups":[1]}]}]'
outer-gaps=uint32 10
overridden-settings="{\"org.gnome.mutter.keybindings\":{\"toggle-tiled-right\":\"['<Super>Right']\",\"toggle-tiled-left\":\"['<Super>Left']\"},\"org.gnome.desktop.wm.keybindings\":{\"maximize\":\"['<Super>Up']\",\"unmaximize\":\"['<Super>Down', '<Alt>F5']\"},\"org.gnome.mutter\":{\"edge-tiling\":\"true\"}}"
override-alt-tab=false
selected-layouts=[['Layout 1'], ['Layout 1']]
show-indicator=false
snap-assistant-animation-time=uint32 180
tile-preview-animation-time=uint32 120
window-use-custom-border-color=false

[org/gnome/shell/extensions/user-theme]
name='Bapirlo-Kuro'

[org/gnome/shell/extensions/vitals]
alphabetize=false
fixed-widths=true
hide-icons=false
hot-sensors=['_processor_usage_', '_temperature_processor_0_', '_memory_usage_']
include-public-ip=false
monitor-cmd='gnome-system-monitor'
position-in-panel=2
show-battery=false
show-fan=false
show-gpu=false
show-storage=false
show-system=false
show-voltage=false
update-time=3

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-lock/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-replay-save/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-replay-toggle/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-shot/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-pick/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-writer/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-captions/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-vault/']
home=['<Super>e']
screensaver=@as []

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-captions]
binding='<Super><Alt>c'
command='@HOME@/bapirlo-os/bin/bapirlo-captions toggle'
name='bapirlo-captions'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-lock]
binding='<Super>l'
command='@HOME@/bapirlo-os/bin/bapirlo-lockd --lock-now'
name='Lock screen (Bapirlo)'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-pick]
binding='<Shift><Super>c'
command='@HOME@/bapirlo-os/bin/bapirlo-capture pick'
name='Colour picker'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-replay-save]
binding='<Super><Alt>g'
command='@HOME@/bapirlo-os/bin/bapirlo-replay save'
name='Save last 30 s (instant replay)'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-replay-toggle]
binding='<Super><Alt>r'
command='@HOME@/bapirlo-os/bin/bapirlo-replay toggle'
name='Instant replay on/off'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-shot]
binding='Print'
command='@HOME@/bapirlo-os/bin/bapirlo-capture shot'
name='Screenshot + annotate (Satty)'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-vault]
binding='<Super><Alt>v'
command='@HOME@/bapirlo-os/bin/bapirlo-vault toggle'
name='bapirlo-vault'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/bapirlo-writer]
binding='<Shift><Super>h'
command='@HOME@/bapirlo-os/writer/bapirlo-writer --clipboard'
name='Bapirlo Writer (clipboard)'

[org/gnome/desktop/wm/keybindings]
maximize=['<Super>Up']
show-desktop=['<Super>d']
switch-applications=['<Super>Tab']
switch-applications-backward=['<Shift><Super>Tab']
switch-input-source=['XF86Keyboard']
switch-input-source-backward=['<Shift>XF86Keyboard']
switch-to-workspace-left=['<Super>Page_Up', '<Super>KP_Prior', '<Super><Alt>Left', '<Control><Alt>Left', '<Control><Super>Left']
switch-to-workspace-right=['<Super>Page_Down', '<Super>KP_Next', '<Super><Alt>Right', '<Control><Alt>Right', '<Control><Super>Right']
switch-windows=['<Alt>Tab']
switch-windows-backward=['<Shift><Alt>Tab']
unmaximize=['<Super>Down', '<Alt>F5']

[org/gnome/shell/keybindings]
screenshot=['<Primary>Print']
show-screenshot-ui=['<Shift>Print']
toggle-application-view=@as []
toggle-message-tray=['<Super>m']

[org/gnome/mutter/keybindings]
toggle-tiled-left=['<Super>Left']
toggle-tiled-right=['<Super>Right']

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'
num-workspaces=5
titlebar-font='Inter SemiBold 10.5'

[org/gnome/desktop/interface]
accent-color='red'
clock-show-date=true
clock-show-seconds=false
clock-show-weekday=true
