<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.bapirlo-control-centre" path="/org/gnome/shell/extensions/bapirlo-control-centre/">
    <key name="tiles" type="as">
      <default>['wifi', 'bluetooth', 'power', 'dnd', 'nightlight', 'caffeine', 'record', 'darkmode', 'volume', 'brightness', 'battery', 'storage', 'media']</default>
      <summary>Tiles shown, in order</summary>
    </key>
    <key name="open-classic" type="as">
      <default><![CDATA[['<Super><Alt>s']]]></default>
      <summary>Open GNOME's original quick settings</summary>
    </key>
  </schema>
</schemalist>
