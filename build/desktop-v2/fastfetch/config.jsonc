// Bapirlo OS — fastfetch ("Kuro" palette; generated by tools/build-desktop-v2.py)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/bapirlo-logo.ans",
    "width": 34,
    "height": 17,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;225;29;46",
      "title": "38;2;240;138;164",
      "output": "38;2;242;233;236"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;38;2;225;29;46mB A P I R L O   O S\u001b[0m  \u001b[38;2;142;118;128m// kuro edition\u001b[0m"
    },
    "title",
    {
      "type": "custom",
      "format": "\u001b[38;2;122;15;26m━━━━━━\u001b[38;2;225;29;46m━━━━━━\u001b[38;2;255;70;85m━━━━━━\u001b[38;2;240;138;164m━━━━━━\u001b[0m"
    },
    {
      "type": "os",
      "key": "󰣇 os",
      "format": "Bapirlo OS ({name} base) {arch}"
    },
    {
      "type": "kernel",
      "key": " kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐 uptime"
    },
    {
      "type": "packages",
      "key": "󰏖 pkgs"
    },
    {
      "type": "shell",
      "key": " shell"
    },
    {
      "type": "de",
      "key": "󰧨 desktop"
    },
    {
      "type": "theme",
      "key": "󰉼 theme"
    },
    {
      "type": "icons",
      "key": "󰀻 icons"
    },
    {
      "type": "terminal",
      "key": " term"
    },
    {
      "type": "cpu",
      "key": "󰻠 cpu"
    },
    {
      "type": "gpu",
      "key": "󰍛 gpu"
    },
    {
      "type": "memory",
      "key": " memory",
      "keyColor": "38;2;240;138;164"
    },
    {
      "type": "disk",
      "key": "󰋊 disk",
      "keyColor": "38;2;240;138;164",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
