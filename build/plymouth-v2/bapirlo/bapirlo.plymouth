[Plymouth Theme]
Name=Kuro OS
Description=Kuro OS "Kuro awakens": fade-up artwork, igniting eyes, rising embers, glowing progress
ModuleName=script
Font=Inter Medium 13
MonospaceFont=JetBrainsMono Nerd Font Mono 12

[script]
