// Kuro OS — fastfetch "Kuro" v3 (70-polish.sh)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/bapirlo-logo.ans",
    "width": 34,
    "height": 17,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;70;85",
      "title": "38;2;240;138;164",
      "output": "38;2;242;233;236",
      "separator": "38;2;133;112;121"
    },
    "key": {
      "width": 11
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "━"
      },
      "width": 10,
      "color": {
        "elapsed": "38;2;225;29;46",
        "total": "38;2;58;42;50"
      },
      "border": null
    },
    "percent": {
      "type": [
        "num",
        "bar"
      ],
      "color": {
        "green": "38;2;242;233;236",
        "yellow": "38;2;242;180;90",
        "red": "38;2;255;70;85"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;38;2;255;70;85mB A P I R L O   O S\u001b[0m  \u001b[38;2;133;112;121m// kuro edition\u001b[0m"
    },
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;122;15;26m━━━━━━\u001b[38;2;225;29;46m━━━━━━\u001b[38;2;255;70;85m━━━━━━\u001b[38;2;240;138;164m━━━━━━\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;133;112;121m── \u001b[1;38;2;240;138;164msystem\u001b[0;38;2;133;112;121m ────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "󰣇 os",
      "format": "Kuro OS ({name} base) {arch}"
    },
    {
      "type": "kernel",
      "key": " kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "󰅐 uptime"
    },
    {
      "type": "packages",
      "key": "󰏖 pkgs"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;133;112;121m── \u001b[1;38;2;240;138;164mdesktop\u001b[0;38;2;133;112;121m ───────────────────────\u001b[0m"
    },
    {
      "type": "de",
      "key": "󰧨 desktop"
    },
    {
      "type": "theme",
      "key": "󰉼 theme"
    },
    {
      "type": "icons",
      "key": "󰀻 icons"
    },
    {
      "type": "font",
      "key": " font"
    },
    {
      "type": "terminal",
      "key": " term"
    },
    {
      "type": "shell",
      "key": " shell"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;133;112;121m── \u001b[1;38;2;240;138;164mhardware\u001b[0;38;2;133;112;121m ──────────────────────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "󰻠 cpu",
      "format": "{name} ({cores-logical})"
    },
    {
      "type": "gpu",
      "key": "󰍛 gpu",
      "format": "{name}"
    },
    {
      "type": "display",
      "key": "󰍹 display",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
    {
      "type": "memory",
      "key": " memory"
    },
    {
      "type": "disk",
      "key": "󰋊 disk",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 1
    }
  ]
}
