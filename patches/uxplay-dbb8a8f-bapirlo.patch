@@ -680,6 +680,32 @@ http_handler_action(raop_conn_t *conn, http_request_t *request, http_response_t
 
 }
 
+/* Bapirlo OS: older-style AirPlay clients send POST /play as "text/parameters"
+   ("Content-Location: <url>\nStart-Position: <fraction>\n") instead of a binary plist.
+   Convert that into the plist the handler expects; the session id doubles as the uuid. */
+static plist_t
+text_parameters_to_plist(const char *data, int datalen, const char *session_id) {
+    char *text = strndup(data, datalen);
+    if (!text) {
+        return NULL;
+    }
+    plist_t root = NULL;
+    for (char *save = NULL, *line = strtok_r(text, "\r\n", &save); line; line = strtok_r(NULL, "\r\n", &save)) {
+        if (!strncasecmp(line, "Content-Location:", strlen("Content-Location:"))) {
+            char *value = line + strlen("Content-Location:");
+            while (*value == ' ') value++;
+            if (*value) {
+                root = plist_new_dict();
+                plist_dict_set_item(root, "Content-Location", plist_new_string(value));
+                plist_dict_set_item(root, "uuid", plist_new_string(session_id));
+                plist_dict_set_item(root, "Start-Position-Seconds", plist_new_real(0.0));
+            }
+        }
+    }
+    free(text);
+    return root;
+}
+
 /* The POST /play request from the Client to Server on the AirPlay http channel contains (among other information)
    the "Content Location" that specifies the HLS Playlists for the video to be streamed, as well as the video 
    "start position in seconds".   Once this request is received by the Sever, the Server sends a POST /event
@@ -716,13 +742,16 @@ http_handler_play(raop_conn_t *conn, http_request_t *request, http_response_t *r
         free (header_str);
     }
 
-    if (!data_is_binary_plist) {
-         logger_log(raop->logger, LOGGER_ERR, "Play request Content is not binary_plist (unsupported)");
+    if (data_is_binary_plist) {
+        plist_from_bin(request_data, request_datalen, &req_root_node);
+    } else if (request_datalen > 0) {
+        req_root_node = text_parameters_to_plist(request_data, request_datalen, apple_session_id);
+    }
+    if (!req_root_node) {
+         logger_log(raop->logger, LOGGER_ERR, "Play request had no usable binary_plist or text/parameters content");
          goto play_error;
     }
 
-    plist_from_bin(request_data, request_datalen, &req_root_node);
-
     plist_t req_uuid_node = plist_dict_get_item(req_root_node, "uuid");
     if (!req_uuid_node) {
        goto play_error;
