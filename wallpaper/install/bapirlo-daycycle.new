#!/usr/bin/env python3
"""Kuro OS — the 10-minute timer (bapirlo-daycycle.timer) and Theme Studio call this.
Wallpapers now live in bapirlo-wallpaper (mode fixed / time / shuffle, live videos, colours → theme);
this keeps the old name working and Night Light following sunrise / sunset.

  bapirlo-daycycle [--no-theme]   = bapirlo-wallpaper tick
  bapirlo-daycycle --status       = bapirlo-wallpaper status
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import bapirlo_wallpaper as W  # noqa: E402

if __name__ == "__main__":
    if "--status" in sys.argv:
        print(W.status())
    else:
        W.tick(no_theme="--no-theme" in sys.argv)
