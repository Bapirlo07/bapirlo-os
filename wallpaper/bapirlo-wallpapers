#!/bin/sh
# Bapirlo Wallpapers — the window (tabs: Wallpapers, Theme).   bapirlo-wallpapers [--page theme] [FILE…]
# Intel-only Vulkan: enumerating the NVIDIA driver would wake the sleeping dGPU (~1.7 s stall).
HERE=$(dirname "$(readlink -f "$0")")
[ -f /usr/share/vulkan/icd.d/intel_icd.json ] && export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/intel_icd.json
exec python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); sys.argv = ["bapirlo-wallpapers"] + sys.argv[2:]; import app; sys.exit(app.main())' "$HERE" "$@"
