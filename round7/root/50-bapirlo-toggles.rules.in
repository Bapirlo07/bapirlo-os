// Bapirlo OS — let @USER@ switch the Control Centre toggles that need root, without a password:
// start/stop ONLY these units, only from the active local session (not over SSH).
//   bapirlo-port@airplay.service / bapirlo-port@localsend.service — firewall opening while on
//   rustdesk.service — RustDesk remote access (off by default, never enabled at boot)
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        subject.user !== "@USER@" || !subject.local || !subject.active)
        return polkit.Result.NOT_HANDLED;
    var unit = action.lookup("unit"), verb = action.lookup("verb");
    var units = ["bapirlo-port@airplay.service", "bapirlo-port@localsend.service", "rustdesk.service"];
    if (units.indexOf(unit) >= 0 && ["start", "stop", "restart"].indexOf(verb) >= 0)
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
