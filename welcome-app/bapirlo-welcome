        row = Gtk.Box(spacing=12, homogeneous=True)
        self.health = {}
        for key, name in (("bat", "Battery"), ("ssd", "SSD"), ("disk", "Storage")):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            col.add_css_class("health-col")
            top = Gtk.Box(spacing=8)
            top.append(label(name, ("health-name",), hexpand=True))
            verdict = label("", ("health-verdict",))
            top.append(verdict)
            col.append(top)
            big = label("…", ("health-big",))
            col.append(big)
            bar = Gtk.ProgressBar()
            col.append(bar)
            detail = label("", ("faint",), wrap=True)
            col.append(detail)
            row.append(col)
            self.health[key] = (big, bar, detail, verdict)
        c.append(row)
        return c

    def load_health(self):
        in_thread(lambda: (health.battery(), health.drives(), health.disk()), self.show_health)
        return True

    def _health_set(self, key, big, frac, detail, verdict, bad=False, warn=False):
        b, bar, d, v = self.health[key]
        b.set_label(big)
        bar.set_fraction(max(0.0, min(1.0, frac)))
        d.set_label(detail)
        v.set_label(verdict)
        for w in (b, v):
            (w.add_css_class if bad else w.remove_css_class)("bad")
        for cls, on in (("bad", bad), ("low", warn and not bad)):
            (bar.add_css_class if on else bar.remove_css_class)(cls)

    def show_health(self, res):
        if isinstance(res, Exception):
            bat, drv, dsk = health.battery(), [], health.disk()
        else:
            bat, drv, dsk = res
        if bat and bat["health"] is not None:
            worn = bat["health"] < health.BATTERY_WORN
            lines = [f"Holds {bat['full']:.2f} of {bat['design']:.2f} {bat['unit']} when new"]
            lines.append(f"{bat['cycles']} charge cycles" if bat["cycles"] else "Cycle count not reported by this battery")
            if bat["limit"] and bat["limit"] != "100":
                lines.append(f"Charging stops at {bat['limit']}% (protects the cells)")
            self._health_set("bat", f"{bat['health']:.0f}% health", bat["health"] / 100, "\n".join(lines),
                             "WORN" if worn else "GOOD", bad=worn, warn=bat["health"] < 75)
        else:
            self._health_set("bat", "—", 0, "No battery information", "")
        if drv:
            d = drv[0]
            probs = health.drive_problems(d)
            life = 100 - (d["used_pct"] or 0)
            lines = [d["model"]]
            if probs:
                lines += probs
            facts = []
            if d["temp_c"] is not None:
                facts.append(f"{d['temp_c']} °C")
            if d["hours"] is not None:
                facts.append(f"{d['hours']:,} h on")
            if d["written_tb"] is not None:
                facts.append(f"{d['written_tb']:.1f} TB written")
            if facts:
                lines.append(" · ".join(facts))
            if d.get("spare_pct") is not None:
                lines.append(f"Spare blocks {d['spare_pct']}% · media errors {d['media_errors'] or 0}"
                             + (f" · {d['unsafe_shutdowns']} unclean power-offs" if d.get("unsafe_shutdowns") else ""))
            self._health_set("ssd", f"{life}% life" if d["used_pct"] is not None else d["kind"] or "OK",
                             life / 100, "\n".join(lines), "CHECK" if probs else "HEALTHY", bad=bool(probs))
        else:
            self._health_set("ssd", "—", 0, "SMART data unavailable (UDisks not running?)", "")
        self._health_set("disk", f"{dsk['free_gb']:.0f} GB free", dsk["used_gb"] / dsk["total_gb"],
                         f"{dsk['used_gb']:.0f} of {dsk['total_gb']:.0f} GB used on /\n"
                         + (f"Below {health.MIN_FREE_GB} GB: updates skip their safety snapshot — free some space"
                            if dsk["low"] else f"Safety snapshots need {health.MIN_FREE_GB} GB free"),
                         "LOW" if dsk["low"] else "OK", bad=dsk["low"], warn=dsk["free_gb"] < 2 * health.MIN_FREE_GB)

    # --- focus: the top-bar timer's log (lib/bapirlo_focus.py) + a start/stop button
    def build_focus(self):
        c = card()
        head = Gtk.Box(spacing=12)
        head.append(label("FOCUS", ("heading",), hexpand=True))
        self.focus_btn = kuro_button("Start a focus block", accent=True, icon="timer-symbolic")
        self.focus_btn.connect("clicked", lambda *_: (launch([os.path.join(BIN, "bapirlo-focus")]),
                                                       GLib.timeout_add(800, lambda: self.refresh_focus() and False)))
        head.append(self.focus_btn)
        c.append(head)
        row = Gtk.Box(spacing=12, homogeneous=True)
        self.focus = {}
        for key, name in (("today", "Today"), ("week", "This week"), ("streak", "Streak")):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            col.add_css_class("health-col")
            col.append(label(name, ("health-name",)))
            big = label("…", ("health-big",))
            col.append(big)
            detail = label("", ("faint",), wrap=True)
            col.append(detail)
            row.append(col)
            self.focus[key] = (big, detail)
        c.append(row)
        return c

    def refresh_focus(self):
        s = focuslog.summary()
        n = lambda k: f"{s[k]} block" + ("" if s[k] == 1 else "s")  # noqa: E731
        self.focus["today"][0].set_label(focuslog.hm(s["today_min"]))
        self.focus["today"][1].set_label(n("today_blocks") if s["today_blocks"] else "Super+Alt+F starts a 25 min block")
        self.focus["week"][0].set_label(focuslog.hm(s["week_min"]))
        days = [s["days"].get(datetime.date.today() - datetime.timedelta(days=i), 0) for i in range(6, -1, -1)]
        self.focus["week"][1].set_label(n("week_blocks") + (f" · best day {focuslog.hm(max(days))}" if any(days) else ""))
        self.focus["streak"][0].set_label(f"{s['streak']} day" + ("" if s["streak"] == 1 else "s"))
        self.focus["streak"][1].set_label("Days in a row with a finished block" if s["streak"] else
                                          "Finish a block today to start one")
        st = focuslog.state()
        if st and st["phase"]:
            what = "focus" if st["phase"] == "focus" else "break"
            left = f"{st['left'] // 60}:{st['left'] % 60:02d}"
            self.focus_btn.get_child().set_label(f"Stop {what} · {left} left" + (" (paused)" if st["paused"] else ""))
        else:
            self.focus_btn.get_child().set_label("Start a focus block")
        self.focus_btn.set_sensitive(st is not None)
        return True

    # --- modes
    def build_modes(self):
        c = card("MODES")
        row = Gtk.Box(spacing=12, homogeneous=True)
        specs = [("gaming", "input-gaming-symbolic", "Gaming mode", "Turbo · DND · replay on"),
                 ("quiet", "weather-clear-night-symbolic", "Quiet mode", "Eco · silent fans · no sounds"),
                 ("dnd", "notifications-disabled-symbolic", "Do Not Disturb", "No notification pop-ups")]
        self.mode_btn = {}
        for key, icon, title, sub in specs:
            b = Gtk.ToggleButton()
            b.add_css_class("mode")
            inner = Gtk.Box(spacing=14)
            img = Gtk.Image(icon_name=icon, pixel_size=30)
            img.add_css_class("mode-icon")
            inner.append(img)
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
            col.append(label(title, ("mode-title",)))
            col.append(label(sub, ("mode-sub",), ellipsize=3))
            inner.append(col)
            state = label("OFF", ("mode-state",))
            inner.append(state)
            b.set_child(inner)
            b._state = state
            b.connect("toggled", self.on_mode, key)
            row.append(b)
            self.mode_btn[key] = b
        c.append(row)
        self.profile_note = label("", ("faint",))
        c.append(self.profile_note)
        return c

    def on_mode(self, btn, key):
        btn._state.set_label("ON" if btn.get_active() else "OFF")
        if self._busy:
            return
        cmd = [os.path.join(BIN, "bapirlo-mode"), key, "on" if btn.get_active() else "off"]
        in_thread(lambda: subprocess.run(cmd, timeout=20), lambda *_: self.refresh_modes())

    def refresh_modes(self):
        st = modes()
        self._busy = True
        for k, b in self.mode_btn.items():
            want = bool(st.get(k))
            if b.get_active() != want:
                b.set_active(want)
            b._state.set_label("ON" if want else "OFF")
        self._busy = False
        prof = st.get("profile", "")
        self.sys["Power mode"].set_label(PROFILE_NAMES.get(prof, prof or "—"))
        held = "held by Gaming mode" if st.get("gaming") else "held by Quiet mode" if st.get("quiet") else \
            "follows the charger (plugged in → Turbo, battery → Eco)"
        self.profile_note.set_label(f"Power profile: {PROFILE_NAMES.get(prof, prof)} — {held}")
        return True

    # --- apps
    def build_apps(self):
        c = card("QUICK LAUNCH")
        favs = [a for a in Gio.Settings.new("org.gnome.shell").get_strv("favorite-apps") if a != f"{APP_ID}.desktop"]
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=10,
                           min_children_per_line=max(4, min(len(favs), 10)), column_spacing=6, row_spacing=6,
                           homogeneous=True)
        for app_id in favs:
            info = DesktopAppInfo.new(app_id)
            if not info:
                continue
            b = Gtk.Button(tooltip_text=info.get_description() or info.get_display_name())
            b.add_css_class("app")
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            img = Gtk.Image(gicon=info.get_icon(), pixel_size=48) if info.get_icon() else \
                Gtk.Image(icon_name="application-x-executable", pixel_size=48)
            col.append(img)
            col.append(label(info.get_display_name(), xalign=0.5, ellipsize=3, max_width_chars=9))
            b.set_child(col)
            b.connect("clicked", self.on_launch, info)
            flow.append(b)
        c.append(flow)
        return c

    def on_launch(self, _btn, info):
        ctx = Gdk.Display.get_default().get_app_launch_context()
        try:
            info.launch([], ctx)
        except GLib.Error:
            pass

    # --- footer
    def build_footer(self):
        f = Gtk.Box(spacing=12)
        f.add_css_class("footer")
        sw = Gtk.Switch(active=not os.path.exists(OFF_FILE), valign=Gtk.Align.CENTER)
        sw.connect("notify::active", self.on_autostart)
        f.append(sw)
        f.append(label("Show at first login of the day", ("dim",), hexpand=True))
        about = kuro_button("About This PC", icon="computer-symbolic")
        about.connect("clicked", lambda *_: launch(["gtk-launch", "os.bapirlo.About"]))
        f.append(about)
        close = kuro_button("Let's go", accent=True)
        close.connect("clicked", lambda *_: self.win.close())
        f.append(close)
        return f

    def on_autostart(self, sw, _):
        os.makedirs(CONF, exist_ok=True)
        if sw.get_active():
            try:
                os.remove(OFF_FILE)
            except FileNotFoundError:
                pass
        else:
            open(OFF_FILE, "w").close()


def first_today():
    """True once per calendar day (and records it)."""
    today = datetime.date.today().isoformat()
    if os.path.exists(OFF_FILE) or read(DAY_FILE) == today:
        return False
    os.makedirs(STATE, exist_ok=True)
    with open(DAY_FILE, "w") as f:
        f.write(today)
    return True


if __name__ == "__main__":
    if "--daily" in sys.argv:
        if not first_today():
            sys.exit(0)
        sys.argv.remove("--daily")
    sys.exit(Welcome().run(sys.argv))
