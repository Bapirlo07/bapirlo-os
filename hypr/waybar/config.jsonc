// Kuro OS — Waybar for the Hyprland session (floating manga bar, like the GNOME top bar).
// Colours: style.css is generated by tools/hypr-theme.py from Theme Studio's palette.
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 6,

    "modules-left": ["custom/logo", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "custom/livewall", "tray", "power-profiles-daemon", "pulseaudio", "network", "bluetooth", "battery", "custom/power"],

    "custom/logo": {
        "format": "B",
        "tooltip-format": "Apps (Super+Space)",
        "on-click": "fuzzel"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "default": "\uf4c3", "active": "\uf444" },
        "persistent-workspaces": { "*": 3 },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "hyprland/window": {
        "max-length": 48,
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": { "mode": "month", "weeks-pos": "", "format": { "today": "<b><u>{}</u></b>" } }
    },
    "mpris": {
        "format": "{status_icon} {title}",
        "status-icons": { "playing": "\uf04b", "paused": "\uf04c" },
        "max-length": 32,
        "on-click": "playerctl play-pause"
    },
    "custom/livewall": {
        "exec": "~/bapirlo-os/bin/bapirlo-hypr-wallpaper --waybar",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/bapirlo-os/bin/bapirlo-wallpaper live toggle; pkill -RTMIN+8 waybar",
        "on-click-right": "~/bapirlo-os/bin/bapirlo-wallpaper"
    },
    "tray": { "icon-size": 16, "spacing": 8 },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "format-icons": { "default": "\uf4bc", "performance": "\uf0e7", "balanced": "\uf24e", "power-saver": "\uf06c" }
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf6a9 muted",
        "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
        "on-click": "pavucontrol",
        "on-click-right": "swayosd-client --output-volume mute-toggle"
    },
    "network": {
        "format-wifi": "\uf1eb {essid}",
        "format-ethernet": "\uf796",
        "format-disconnected": "\uf05e",
        "tooltip-format": "{ifname} {ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "\uf293",
        "format-connected": "\uf293 {num_connections}",
        "format-disabled": "\uf294",
        "on-click": "blueman-manager"
    },
    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-plugged": "\uf1e6 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"]
    },
    "custom/power": {
        "format": "\uf011",
        "tooltip-format": "Lock, log out, restart… (Super+Shift+E)",
        "on-click": "~/bapirlo-os/bin/bapirlo-hypr-power"
    }
}
