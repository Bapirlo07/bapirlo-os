# Kuro OS final round — settings for the extensions added in 900-final.sh (@HOME@ = your home).
# Loaded with: sed "s|@HOME@|$HOME|g" new-extensions.dconf | dconf load /org/gnome/shell/extensions/

[Logo-menu]
use-custom-icon=true
custom-icon-path='@HOME@/bapirlo-os/assets/bapirlo-symbolic.svg'
symbolic-icon=true
menu-button-icon-size=22
hide-icon-shadow=true
show-activities-button=false
show-power-options=true
show-lockscreen=true
hide-forcequit=false
hide-softwarecentre=false
menu-button-terminal='alacritty'
menu-button-software-center='cachyos-pi'
menu-button-system-monitor='resources'
menu-button-extensions-app='org.gnome.Extensions.desktop'

[lockkeys]
style='both'
notification-preferences='osd'
capslock-indicator='when-active'
numlock-indicator='never'
capslock-notification='osd'
numlock-notification='osd'

[just-perfection]
animation=5
notification-banner-position=2
startup-status=0
double-super-to-appgrid=false
support-notifier-type=0
window-demands-attention-focus=true

[Bluetooth-Battery-Meter]
indicator-type=1
enable-battery-level-text=true
enable-on-hover-mode=true

[alphabetical-app-grid]
sort-folder-contents=true
folder-order-position='alphabetical'

[wiggly]
draw-interval=16
sample-size=13
check-interval=250

[arcmenu]
menu-button-appearance='None'
