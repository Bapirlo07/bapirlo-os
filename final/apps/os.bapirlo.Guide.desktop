[Desktop Entry]
Type=Application
Name=Bapirlo OS Guide
GenericName=Manual
Comment=Everything on Bapirlo OS: apps, shortcuts, features, Windows and troubleshooting
Exec=env VK_DRIVER_FILES=/usr/share/vulkan/icd.d/intel_icd.json __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json @OS@/apps/guide/bapirlo-guide
Icon=bapirlo-guide
Terminal=false
Categories=Utility;Documentation;
Keywords=manual;help;guide;shortcuts;keyboard;troubleshooting;emergency;bapirlo;
StartupWMClass=os.bapirlo.Guide
Actions=emergency;

[Desktop Action emergency]
Name=Emergency sheet
Exec=env VK_DRIVER_FILES=/usr/share/vulkan/icd.d/intel_icd.json __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json @OS@/apps/guide/bapirlo-guide --emergency
