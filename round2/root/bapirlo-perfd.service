[Unit]
Description=Kuro OS MSI power glue (power profile <-> msi-ec, AC/battery switching, charge limit)
After=power-profiles-daemon.service upower.service
Wants=power-profiles-daemon.service upower.service

[Service]
Type=simple
ExecStart=/usr/local/lib/bapirlo/bapirlo-perfd
Restart=on-failure
RestartSec=5
Nice=10
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
# graphical.target, not multi-user: CachyOS orders power-profiles-daemon After=multi-user.target,
# so multi-user here made a start-up cycle and systemd dropped this service at boot
WantedBy=graphical.target
