[Unit]
Description=Google Drive at ~/GoogleDrive (rclone)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive
ExecStart=/usr/bin/rclone mount gdrive: %h/GoogleDrive --vfs-cache-mode full --vfs-cache-max-size 5G --vfs-cache-max-age 72h --dir-cache-time 30m --poll-interval 1m --umask 022 --log-level NOTICE
ExecStop=/usr/bin/fusermount3 -uz %h/GoogleDrive
Restart=on-failure
RestartSec=20
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
